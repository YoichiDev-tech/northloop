# Copy this file to .env.local and fill in your Supabase project values.
# We never commit real keys — only this example.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required server-only key for the contact / demo API route; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
